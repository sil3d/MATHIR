{
  "memory": {
    "embedding_dim": 384,
    "internal_dim": 512,
    "working_capacity": 64,
    "episodic_capacity": 1000,
    "semantic_prototypes": 256,
    "immunological_capacity": 100,
    "kl_coefficient": 0.01,
    "anomaly_threshold": 20.0,
    "_anomaly_threshold_note": "Calibrated against the eval corpus in mathir_mcp/tests/data/anomaly_eval/ (normal_mean=18.6, normal_std=0.69) -- not a purely theoretical value.",
    "anomaly_warmup_count": 60,
    "decay_rate": 0.95
  },
  "router": {
    "type": "kl_constrained",
    "kl_coefficient": 0.01,
    "hidden_dim": 128
  },
  "storage": {
    "type": "sqlite",
    "db_path": "~/.config/opencode/data/mathir.db",
    "auto_save": true
  },
  "embedding": {
    "model": "intfloat/multilingual-e5-small",
    "device": "cuda"
  }
}
