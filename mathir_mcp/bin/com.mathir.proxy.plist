<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mathir.proxy</string>
    <!--
      Template, same substitution rules as com.mathir.daemon.plist:
      /Users/USERNAME and the python interpreter must be resolved before
      install (see INSTALL_FOR_AGENT/INSTALL_MACOS.md or install_smart.py).
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>python3</string>
        <string>/Users/USERNAME/.config/MATHIR/mathir_mcp/mathir_lib/mathir_proxy.py</string>
        <string>--port</string>
        <string>7339</string>
        <string>--target</string>
        <string>https://api.anthropic.com</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
