# MATHIR Benchmarks — Centralized environment file
# Copy to .env (same dir) and fill in your values. .env is gitignored.
#
# Usage from any benchmark subdirectory:
#   - python auto-loads via _env.py helper if you `from _env import *`
#   - OR source manually before running: `set -a && . .env && set +a`
#   - OR export individually: `MATHIR_API_KEY=sk-... python benchmarks/04_.../ai_cognitive_bench.py`

# =============================================================================
# LLM provider backend
# =============================================================================
# - "openrouter" : cloud, free models at https://openrouter.ai/keys
# - "api"        : direct OpenAI-compatible API (set MATHIR_API_BASE) --
#                  MiniMax's native endpoint, OpenCode Zen, etc.
# - "auto"       : picks based on whether OPENAI_API_KEY / MATHIR_API_KEY is set
# No "ollama" option here: 08_industry_validation's llm_client.py deliberately
# does not support a local Ollama backend -- not fast enough for
# benchmark-scale runs (hundreds to thousands of LLM calls per pass).
MATHIR_LLM_BACKEND=auto

# =============================================================================
# API keys (NEVER commit)
# =============================================================================
# OpenRouter (free tier available)
# Get one at: https://openrouter.ai/keys
MATHIR_API_KEY=
OPENROUTER_API_KEY=

# Cross-LLM benchmark providers (used by 01_cross_llm_benchmark)
GOOGLE_AI_STUDIO_KEY=
MINIMAX_API_KEY=
NVIDIA_API_KEY=
OPENCODE_ZEN_KEY=

# Groq (ultra-fast LPU inference, free tier — RECOMMENDED provider)
# Get a key at: https://console.groq.com/keys
# API base: https://api.groq.com/openai/v1 (OpenAI-compatible)
# Best model: llama-3.3-70b-versatile (85.7% on LongMemEval, 280 T/s)
# Also available: openai/gpt-oss-120b, qwen/qwen3-32b, llama-4-scout-17b
# Benchmarked 2026-07-02: Groq Llama 3.3 70B scored +14pp over MiniMax-M2.7
GROQ_API_KEY=

# =============================================================================
# API base + model
# =============================================================================
# Custom API base (only if not using OpenRouter)
# MATHIR_API_BASE=https://api.openrouter.ai/api/v1
#
# OpenCode Zen is another OpenAI-compatible option with free models:
#   MATHIR_API_BASE=https://opencode.ai/zen/v1
#   MATHIR_API_KEY=<your OpenCode Zen key, from https://opencode.ai/auth>
#   Free models confirmed as of this writing: mimo-v2.5-free,
#   deepseek-v4-flash-free, nemotron-3-ultra-free, north-mini-code-free.
#   NOTE: MiniMax on OpenCode Zen (minimax-m2.5 / m2.7 / m3) is PAID, not
#   free -- don't set MATHIR_API_MODEL to a minimax-* id expecting it to
#   be free. Full current list: GET https://opencode.ai/zen/v1/models

# Model for OpenRouter (free models curated for benchmarks)
# Options: meta-llama/llama-3.3-70b-instruct:free (recommended)
#          qwen/qwen3-next-80b-a3b-instruct:free
#          openai/gpt-oss-120b:free
#          google/gemma-4-31b-it:free
#          meta-llama/llama-3.2-3b-instruct:free (fast)
MATHIR_API_MODEL=meta-llama/llama-3.3-70b-instruct:free

# =============================================================================
# MiniMax (native OpenAI-compatible endpoint -- not OpenCode Zen, which only
# offers MiniMax as a paid model; this is MiniMax's own API)
# =============================================================================
# MATHIR_API_BASE=https://api.minimax.io/v1
# MATHIR_API_KEY=<your MiniMax API key>
# Real model ids: MiniMax-M3 (strongest -- recommended as MATHIR_JUDGE_MODEL,
# see below) and MiniMax-M2.7 (faster/cheaper -- fine as the answer-generation
# model). Do not set MATHIR_LLM_BACKEND=openrouter when pointing at MiniMax
# directly -- use MATHIR_LLM_BACKEND=api (or leave =auto with the key set).

# =============================================================================
# Per-role model overrides (benchmarks/08_industry_validation/)
# =============================================================================
# Ingest/search use MATHIR itself (no LLM). Only the answer-generation step
# and the judge step call out to an LLM, and they don't have to be the same
# model/provider -- e.g. a fast/cheap model to generate answers, and your
# strongest model to judge them (matches how Mem0/Zep's own harnesses often
# split these roles). Both are optional: unset = falls back to whatever
# MATHIR_API_MODEL / OPENAI_MODEL resolves to for that backend.
#
# MATHIR_BENCHMARK_ANSWER_MODEL=MiniMax-M2.7
# MATHIR_BENCHMARK_JUDGE_MODEL=MiniMax-M3
#
# For results directly comparable to published Mem0/Zep LongMemEval/LoCoMo
# numbers specifically, MATHIR_BENCHMARK_JUDGE_MODEL must be gpt-4o (what
# those benchmarks were originally scored with) -- any other judge model
# (MiniMax-M3 included) gives a real, internally-consistent signal for
# tracking MATHIR over time, but isn't apples-to-apples with those published
# scores.
#
# Reasoning/"thinking" models (MiniMax-M3/M2.7 and similar) spend tokens on
# internal reasoning before emitting the final visible answer -- those
# reasoning tokens count against max_tokens on most providers, and can run
# into the thousands for a hard question. Raise these further if your
# model's responses still come back truncated/empty:
# MATHIR_BENCHMARK_ANSWER_MAX_TOKENS=16000
# MATHIR_BENCHMARK_JUDGE_MAX_TOKENS=8000

# =============================================================================
# Cross-LLM benchmark — models per provider
# =============================================================================
# 01_cross_llm_benchmark/benchmark.py uses these models:
GOOGLE_MODEL=gemini-2.5-pro
MINIMAX_MODEL=MiniMax-Text-01
NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
# "opencode/zen-mini" is not a current OpenCode Zen model id -- corrected
# to a real, currently-free one. Verify against GET
# https://opencode.ai/zen/v1/models if this changes over time.
OPENCODE_ZEN_MODEL=mimo-v2.5-free

# =============================================================================
# OpenRouter ranking (optional, helps free-tier rate limits)
# =============================================================================
MATHIR_OPENROUTER_REFERER=https://github.com/sil3d/MATHIR
MATHIR_OPENROUTER_TITLE=MATHIR Benchmark
